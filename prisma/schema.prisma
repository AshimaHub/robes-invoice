generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  legalName    String
  tin          String
  businessId   String?
  serviceId    String
  addressLine1 String?
  city         String?
  state        String?
  lga          String?
  nrsEnv       String   @default("SANDBOX") // SANDBOX | PRODUCTION
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branding       Branding?
  credentials    Credential[]
  memberships    Membership[]
  parties        Party[]
  invoices       Invoice[]
  auditEvents    AuditEvent[]
  nrsGateProgress NrsGateProgress[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  auditEvents     AuditEvent[]
  nrsGateProgress NrsGateProgress[]
}

model Membership {
  id        String   @id @default(cuid())
  role      String // TENANT_ADMIN | ISSUER | APPROVER | VIEWER
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model Branding {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  primaryColor       String  @default("#0B5E3C")
  secondaryColor     String  @default("#C4A35A")
  accentColor        String  @default("#1A3A2A")
  logoUrl            String?
  faviconUrl         String?
  loginHeroText      String?
  emailFromName      String?
  domainHint         String?
  /// Display name shown on company invoices (editable preference).
  invoiceCompanyName String?
  invoicePhone       String?
  invoiceEmail       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Credential {
  id             String    @id @default(cuid())
  tenantId       String
  environment    String // SANDBOX | PRODUCTION
  label          String
  encryptedBlob  String // stub: base64 of JSON secrets — never return to browser after save
  lastRotatedAt  DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Party {
  id           String   @id @default(cuid())
  tenantId     String
  type         String // CUSTOMER | SUPPLIER
  name         String
  tin          String?
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  lga          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id               String    @id @default(cuid())
  tenantId         String
  partyId          String?
  channel          String    @default("COMPANY") // COMPANY | NRS
  documentType     String    @default("INVOICE") // INVOICE | CREDIT_NOTE | DEBIT_NOTE
  invoiceKind      String    @default("B2B") // B2B | B2C | B2G
  invoiceNumber    String
  issueDate        DateTime  @default(now())
  dueDate          DateTime?
  currency         String    @default("NGN")
  // COMPANY: DRAFT | ISSUED | VOID — NRS: DRAFT | SUBMITTED | VALID | INVALID | CANCELED
  status           String    @default("DRAFT")
  irn              String?
  qrPayload        String?
  qrSvg            String?
  mockClearanceAt  DateTime?
  validationMsg    String?
  notes            String?
  paymentTerms     String?
  relatedInvoiceId String?
  /// Company-invoice letterhead snapshot (not NRS).
  sellerName       String?
  sellerAddress    String?
  sellerPhone      String?
  sellerEmail      String?
  sellerTin        String?
  buyerName        String?
  buyerAddress     String?
  buyerEmail       String?
  buyerPhone       String?
  includeQr        Boolean   @default(false)
  logoSnapshotUrl  String?
  subtotal         Float     @default(0)
  vatTotal         Float     @default(0)
  grandTotal       Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party          Party?         @relation(fields: [partyId], references: [id])
  relatedInvoice Invoice?       @relation("InvoiceAdjustments", fields: [relatedInvoiceId], references: [id])
  adjustments    Invoice[]      @relation("InvoiceAdjustments")
  lines          InvoiceLine[]
  events         ClearanceEvent[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, channel])
}

/// Prerequisite questionnaire before NRS Compliant e-Invoice features.
model NrsGateProgress {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  answersJson String    @default("{}")
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float   @default(7.5)
  lineTotal   Float
  vatAmount   Float
  hsnCode     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ClearanceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  status    String
  message   String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}
